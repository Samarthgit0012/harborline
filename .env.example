# Copy to .env (never commit .env)
# Twilio Console > Account Info
TWILIO_AUTH_TOKEN=replace_me

# The PUBLIC https URL Twilio calls, no trailing slash. Locally with the simulator: http://localhost:3000
# With ngrok: https://<your-id>.ngrok-free.app   (must match EXACTLY what you typed in the Twilio Console)
PUBLIC_BASE_URL=http://localhost:3000

PORT=3000

# Where "press 0 / speak to an agent" rings. Use your own second phone while learning. E.164 format.
# Leave empty to test without dialing anyone (callers are told no agent is available).
AGENT_PHONE=

# Dev only: pretend it is this moment, to test open/closed hours. Ignored when NODE_ENV=production.
# Example (Saturday 5pm New York time, so closed): NOW_OVERRIDE=2026-11-14T22:00:00Z
NOW_OVERRIDE=

# Optional: send real texts (ID card). Without BOTH of these, texts are skipped and only logged.
# TWILIO_ACCOUNT_SID is in Twilio Console > Account Info; the from-number must be a Twilio number you own.
TWILIO_ACCOUNT_SID=
TWILIO_FROM_NUMBER=

# SQLite file for policies and claims (sample data is created on first run).
DB_PATH=data/harborline.db

# Optional: https URL of an mp3/wav you host, played to callers waiting for an agent. Blank = short pauses.
HOLD_MUSIC_URL=

# Card payments by phone. OFF unless you set up a Twilio Pay Connector (Console > Pay Connectors) and turn this on.
# Needs PUBLIC_BASE_URL to be https. Never put card numbers, processor keys or tokens in this repo.
PAY_ENABLED=false
# Unique name of the Pay Connector you installed. Leave blank to use the one named "Default".
PAY_CONNECTOR=

# Outbound calling (campaigns). OFF by default. "dry-run" rings nobody and only shows what the compliance gate would do.
# "live" places real calls: read Lesson 11 first. It needs OUTBOUND_FROM (a Twilio number you own), OUTBOUND_CALLBACK
# (the number people can call to be removed, spoken in every message), TWILIO_ACCOUNT_SID and an https PUBLIC_BASE_URL.
OUTBOUND_MODE=off
OUTBOUND_FROM=
OUTBOUND_CALLBACK=

# Recording and data retention (Lesson 12). Recording is OFF for agent calls unless you turn it on; claims and voicemail always say they are recorded.
# RECORD_AGENT_CALLS=true announces "this call may be recorded" first and lets the caller press 2 to decline.
RECORD_AGENT_CALLS=false
# Days to keep each kind of recording. PLACEHOLDERS: set them from the client's own retention schedule and have their lawyer approve.
RETENTION_VOICEMAIL_DAYS=90
RETENTION_AGENT_CALL_DAYS=90
RETENTION_CLAIM_DAYS=730
# dry-run (default) only reports what would be deleted. live really deletes at Twilio: it cannot be undone.
RETENTION_MODE=dry-run

# --- Real-phone demo (see DEMO.md) ---
# Your Twilio number (E.164). Used by `npm run doctor` and `npm run twilio:setup`.
TWILIO_PHONE_NUMBER=
# DEMO ONLY: "always-open" ignores business hours. Leave as business for anything real.
HOURS_MODE=business
